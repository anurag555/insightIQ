# InsightIQ Root Environment Template
# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=insightiq_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# MongoDB (Defaults to local or automatic in-memory MongoMemoryServer)
MONGODB_URI=mongodb://127.0.0.1:27017/insightiq

# PostgreSQL Analytical Data Warehouse
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=root
PG_DATABASE=insightiq

# AI Configuration (Leave blank for deterministic demo mode)
OPENAI_API_KEY=
DEMO_MODE=true

# Frontend URL
CLIENT_URL=http://localhost:3000
