PORT=5000
NODE_ENV=development
JWT_SECRET=insightiq_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# MongoDB connection (defaults to local Mongo or automatic MongoMemoryServer)
MONGODB_URI=mongodb://127.0.0.1:27017/insightiq

# PostgreSQL Analytical Database
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=root
PG_DATABASE=insightiq

# OpenAI Credentials (leave blank to run in Deterministic Demo Mode)
OPENAI_API_KEY=
DEMO_MODE=true

CLIENT_URL=http://localhost:3000
